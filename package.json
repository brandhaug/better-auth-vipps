{
	"name": "better-auth-vipps",
	"version": "0.0.0",
	"private": true,
	"description": "Vipps MobilePay Login provider for Better Auth. Initial specification and tooling scaffold.",
	"homepage": "https://github.com/brandhaug/better-auth-vipps#readme",
	"bugs": {
		"url": "https://github.com/brandhaug/better-auth-vipps/issues"
	},
	"license": "MIT",
	"author": "Martin Brandhaug",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/brandhaug/better-auth-vipps.git"
	},
	"workspaces": [],
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"prepare": "git config core.hooksPath .githooks",
		"lint": "oxlint --type-aware",
		"lint:fix": "oxlint --type-aware --fix",
		"format": "oxfmt --write",
		"format:check": "oxfmt --check",
		"typecheck": "tsc --noEmit",
		"test": "bun test --pass-with-no-tests",
		"build": "tsc -p tsconfig.build.json",
		"dead-code": "fallow dead-code --fail-on-regression",
		"validate": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && bun run dead-code",
		"prepublishOnly": "bun run validate"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"better-auth": "catalog:",
		"lint-staged": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"typescript": "catalog:",
		"ultracite": "catalog:"
	},
	"engines": {
		"bun": ">=1.4.0"
	},
	"packageManager": "bun@1.4.0",
	"catalog": {
		"@types/node": "26.4.1",
		"lint-staged": "17.4.1",
		"oxfmt": "0.66.0",
		"oxlint": "1.81.0",
		"oxlint-tsgolint": "7.0.2001",
		"typescript": "7.0.2",
		"ultracite": "7.10.7",
		"@types/bun": "1.4.0",
		"better-auth": "1.7.2"
	}
}
