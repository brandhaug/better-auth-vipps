{
	"name": "better-auth-vipps",
	"version": "0.1.6",
	"description": "Vipps MobilePay Login provider for Better Auth.",
	"homepage": "https://github.com/brandhaug/better-auth-vipps#readme",
	"bugs": {
		"url": "https://github.com/brandhaug/better-auth-vipps/issues"
	},
	"license": "MIT",
	"author": "Martin Brandhaug",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/brandhaug/better-auth-vipps.git"
	},
	"workspaces": [],
	"files": [
		"dist/"
	],
	"type": "module",
	"sideEffects": false,
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prepare": "git config core.hooksPath .githooks",
		"lint": "oxlint --type-aware",
		"lint:fix": "oxlint --type-aware --fix",
		"format": "oxfmt --write",
		"format:check": "oxfmt --check",
		"typecheck": "bun check",
		"test": "bun test --max-concurrency=1",
		"build": "tsc -p tsconfig.build.json",
		"pack:check": "node scripts/pack-check.mjs",
		"dead-code": "bunx --bun fallow@3 dead-code --fail-on-regression",
		"validate": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && bun run pack:check && bun run dead-code",
		"example": "bun examples/browser.ts"
	},
	"dependencies": {
		"jose": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"better-auth": "catalog:",
		"lint-staged": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"better-auth": "1.7.2"
	},
	"engines": {
		"bun": ">=1.4.4"
	},
	"packageManager": "bun@1.4.4",
	"catalog": {
		"@types/node": "26.6.5",
		"lint-staged": "17.6.0",
		"oxfmt": "0.74.0",
		"oxlint": "1.89.0",
		"oxlint-tsgolint": "7.0.2004",
		"typescript": "7.0.2",
		"@types/bun": "1.4.3",
		"better-auth": "1.7.10",
		"jose": "6.2.12"
	}
}
